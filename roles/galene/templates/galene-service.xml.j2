<!-- {{ ansible_managed | default('Managed by lineadicomando.win_workman.galene') }} -->
<service>
  <id>{{ win_workman_galene_service_name }}</id>
  <name>{{ win_workman_galene_service_name }}</name>
  <description>Galène videoconference server: teacher screen and audio for the students (win_workman galene {{ win_workman_galene_version }})</description>
  <executable>%BASE%\galene.exe</executable>
  <arguments>-insecure -http :{{ win_workman_galene_http_port }} -udp-range {{ win_workman_galene_udp_port }} -turn ""</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>5 sec</stoptimeout>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
</service>
