<?xml version="1.0" encoding="utf-8"?>
<!--
  Answer file of the win_iso role of lineadicomando.win_workman. Windows Setup finds it
  at the root of the installation media. In the specialize pass, as SYSTEM and before
  any logon, it runs C:\Windows\Setup\Scripts\win_workman\setup.ps1, copied there from
  sources\$OEM$ of the same media, which sets up OpenSSH Server (ssh={{ win_workman_win_iso_ssh_mode }}).
  Then OOBE creates the local administrator {{ win_workman_win_iso_user }}.
  It holds the account password: keep the ISO and the USB sticks made from it safe.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>{{ win_workman_win_iso_language }}</UILanguage>
      </SetupUILanguage>
      <InputLocale>{{ win_workman_win_iso_input_locale }}</InputLocale>
      <SystemLocale>{{ win_workman_win_iso_locale }}</SystemLocale>
      <UILanguage>{{ win_workman_win_iso_language }}</UILanguage>
      <UserLocale>{{ win_workman_win_iso_locale }}</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
{% if win_workman_win_iso_bypass_requirements | bool %}
      <RunSynchronous>
        <!-- Lets Setup go on without TPM 2.0, Secure Boot or 4 GB of RAM. -->
{% for check in ['BypassTPMCheck', 'BypassSecureBootCheck', 'BypassRAMCheck'] %}
        <RunSynchronousCommand wcm:action="add">
          <Order>{{ loop.index }}</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v {{ check }} /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
{% endfor %}
      </RunSynchronous>
{% endif %}
      <DynamicUpdate>
        <Enable>false</Enable>
      </DynamicUpdate>
{% if win_workman_win_iso_wipe_disk | bool %}
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>300</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>16</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>FAT32</Format>
              <Label>System</Label>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
{% endif %}
{% if win_workman_win_iso_wipe_disk | bool or win_workman_win_iso_image_name | length > 0 %}
      <ImageInstall>
        <OSImage>
{% if win_workman_win_iso_image_name | length > 0 %}
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>{{ win_workman_win_iso_image_name | e }}</Value>
            </MetaData>
          </InstallFrom>
{% endif %}
{% if win_workman_win_iso_wipe_disk | bool %}
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
{% endif %}
        </OSImage>
      </ImageInstall>
{% endif %}
      <UserData>
        <AcceptEula>true</AcceptEula>
        <FullName>{{ win_workman_win_iso_user }}</FullName>
        <Organization>{{ win_workman_win_iso_organization | e }}</Organization>
{% if win_workman_win_iso_product_key | length > 0 %}
        <ProductKey>
          <Key>{{ win_workman_win_iso_product_key }}</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
{% endif %}
      </UserData>
    </component>
  </settings>
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>{{ win_workman_win_iso_computer_name }}</ComputerName>
      <TimeZone>{{ win_workman_win_iso_timezone }}</TimeZone>
    </component>
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Lets OOBE go on without asking for a network or a Microsoft account. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE /v BypassNRO /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
{% if win_workman_win_iso_prevent_bitlocker | bool %}
        <!-- No automatic device encryption: the disk would be locked to the TPM of the PC. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg.exe add HKLM\SYSTEM\CurrentControlSet\Control\BitLocker /v PreventDeviceEncryption /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
{% endif %}
        <!-- OpenSSH Server and the rest of the setup script: offline, before the first logon. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Description>win_workman: setup script</Description>
          <Path>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\win_workman\setup.ps1</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>{{ win_workman_win_iso_input_locale }}</InputLocale>
      <SystemLocale>{{ win_workman_win_iso_locale }}</SystemLocale>
      <UILanguage>{{ win_workman_win_iso_language }}</UILanguage>
      <UserLocale>{{ win_workman_win_iso_locale }}</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <TimeZone>{{ win_workman_win_iso_timezone }}</TimeZone>
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>{{ win_workman_win_iso_user }}</Name>
            <DisplayName>{{ win_workman_win_iso_user }}</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value>{{ win_workman_win_iso_password | e }}</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
    </component>
  </settings>
</unattend>
