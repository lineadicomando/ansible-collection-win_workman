# Specialize pass of an installation from an ISO of the win_iso role of
# lineadicomando.win_workman: runs as SYSTEM before OOBE and before any logon.
{% if win_workman_win_iso_ssh_mode == 'none' %}
# Built with ssh=none: no OpenSSH Server, only the settings below.
{% else %}
# Makes the PC reachable by Ansible: OpenSSH Server with PowerShell as its shell,
# port 22 open on every profile, the key of the controller for Administrators.
{% if win_workman_win_iso_ssh_mode == 'msi' %}
# OpenSSH comes from the Win32-OpenSSH MSI next to this script (ssh=msi): no
# network, no Windows Update, and Windows Update does not update it later.
{% else %}
# OpenSSH is the Windows capability, already in the image (ssh=dism): this script
# only configures it, and Windows Update keeps it updated.
{% endif %}
# Keys and sshd_config live in C:\ProgramData\ssh in both cases.
{% endif %}
# Log: C:\Windows\Temp\win_workman-setup.log; outcome: win_workman-setup.done or .failed.
$ErrorActionPreference = 'Stop'
$log = 'C:\Windows\Temp\win_workman-setup'
$here = Split-Path -Parent $MyInvocation.MyCommand.Path
Start-Transcript -Path "$log.log" -Append
try {
{% if win_workman_win_iso_ssh_mode == 'msi' %}
    # WaitForExit on the process alone: Start-Process -Wait would also wait for
    # every process msiexec leaves behind.
    $msi = Join-Path $here '{{ win_workman_win_iso_openssh_msi }}'
    $p = Start-Process msiexec.exe -PassThru -ArgumentList @(
        '/i', "`"$msi`"", 'ADDLOCAL=Server', '/qn', '/norestart', '/l*v', "`"$log-msi.log`"")
    if (-not $p.WaitForExit(900000)) { throw 'msiexec still running after 15 minutes' }
    if ($p.ExitCode -notin 0, 3010) { throw "msiexec exit code $($p.ExitCode), see $log-msi.log" }

{% endif %}
{% if win_workman_win_iso_ssh_mode != 'none' %}
    if (-not (Get-Service -Name sshd -ErrorAction SilentlyContinue)) {
        throw 'the sshd service does not exist'
    }
    Set-Service -Name sshd -StartupType Automatic
    New-Item -Path HKLM:\SOFTWARE\OpenSSH -Force | Out-Null
    New-ItemProperty -Path HKLM:\SOFTWARE\OpenSSH -Name DefaultShell -PropertyType String -Force `
        -Value "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" | Out-Null
    if (-not (Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue)) {
        New-NetFirewallRule -Name OpenSSH-Server-In-TCP -DisplayName 'OpenSSH SSH Server (sshd)' `
            -Direction Inbound -Protocol TCP -LocalPort 22 -Action Allow | Out-Null
    }
    Set-NetFirewallRule -Name OpenSSH-Server-In-TCP -Enabled True -Profile Any

    # Key of the Ansible controller, for the members of Administrators. sshd ignores
    # the file unless only Administrators and SYSTEM can access it (SIDs: the group
    # names are localised).
    $keys = Join-Path $here 'administrators_authorized_keys'
    if (Test-Path $keys) {
        $dest = "$env:ProgramData\ssh\administrators_authorized_keys"
        New-Item -Path (Split-Path $dest) -ItemType Directory -Force | Out-Null
        Copy-Item -Path $keys -Destination $dest -Force
        icacls.exe $dest /inheritance:r /grant '*S-1-5-32-544:F' '*S-1-5-18:F' | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "icacls exit code $LASTEXITCODE" }
    }

{% endif %}
    # Hibernation keeps fast startup on: a "shut down" PC is then hibernated, and
    # Wake-on-LAN and disk maintenance work less reliably.
    powercfg.exe /hibernate off

    # OOBE works as defaultuser0, a local administrator without password, and
    # Windows deletes it only at the first interactive logon, which a PC managed
    # over SSH may never see. A task removes it, with its profile, once OOBE is
    # over, then removes itself. Not fatal: SSH matters more.
    #
    # "Over" is the hard part. OOBEInProgress, SystemSetupInProgress and
    # ImageState all reach their final values while OOBE still runs in the session
    # of defaultuser0: deleting the account then kills that session and OOBE stops
    # with "Si e' verificato un errore - REBOOT". So the task waits until OOBE has
    # signed defaultuser0 in (its profile exists) and out again (no process runs as
    # it, the profile is unloaded), on two runs in a row, since OOBE may restart the
    # PC half way and sign in again.
    #
    # Winlogon keeps the automatic sign-in as defaultuser0 that OOBE set up: with
    # the account gone, every boot shows "Nome utente o password non corretta".
    # The task clears it together with the account.
    try {
        $dir = "$env:ProgramData\win_workman"
        New-Item -Path $dir -ItemType Directory -Force | Out-Null
        Set-Content -Path "$dir\remove-defaultuser0.ps1" -Encoding UTF8 -Value @'
$log = 'C:\Windows\Temp\win_workman-defaultuser0.log'
function Write-Log([string]$Message) {
    Add-Content -Path $log -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') $Message"
}
$idle = Join-Path $PSScriptRoot 'defaultuser0.idle'
function Wait-Next([string]$Why) {
    Remove-Item -Path $idle -Force -ErrorAction SilentlyContinue
    Write-Log "waiting: $Why"
    exit 0
}

$state = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Setup\State' -ErrorAction SilentlyContinue).ImageState
if ($state -ne 'IMAGE_STATE_COMPLETE') { Wait-Next "image state $state" }

$user = Get-LocalUser -Name defaultuser0 -ErrorAction SilentlyContinue
$profiles = @(Get-CimInstance Win32_UserProfile | Where-Object { $_.LocalPath -like '*\defaultuser0*' })
if ($user) {
    if ($profiles.Count -eq 0) { Wait-Next 'OOBE has not signed defaultuser0 in yet' }
    if ($profiles | Where-Object Loaded) { Wait-Next 'the profile of defaultuser0 is loaded' }
    $busy = @(Get-Process -IncludeUserName -ErrorAction SilentlyContinue |
        Where-Object { $_.UserName -like '*\defaultuser0' })
    if ($busy.Count -gt 0) { Wait-Next "$($busy.Count) processes run as defaultuser0" }
    # Idle now: act only if it was idle at the previous run too.
    if (-not (Test-Path -Path $idle)) {
        New-Item -Path $idle -ItemType File -Force | Out-Null
        Write-Log 'defaultuser0 idle, checking again at the next run'
        exit 0
    }
}

$wl = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
if ((Get-ItemProperty -Path $wl).DefaultUserName -eq 'defaultuser0') {
    Set-ItemProperty -Path $wl -Name AutoAdminLogon -Value '0'
    foreach ($name in 'DefaultUserName', 'AutoLogonSID', 'DefaultPassword', 'AutoLogonCount') {
        Remove-ItemProperty -Path $wl -Name $name -ErrorAction SilentlyContinue
    }
    Write-Log 'automatic sign-in as defaultuser0 cleared'
}
if ($user) {
    Remove-LocalUser -Name defaultuser0
    Write-Log 'account defaultuser0 removed'
}
try {
    $profiles | Remove-CimInstance -ErrorAction Stop
} catch {
    Write-Log "profile not removed yet: $($_.Exception.Message)"
    exit 0
}
Write-Log 'done, task removed'
Unregister-ScheduledTask -TaskName 'win_workman remove defaultuser0' -Confirm:$false
Remove-Item -Path $PSScriptRoot -Recurse -Force
'@
        $trigger = New-ScheduledTaskTrigger -AtStartup
        $repeat = New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 5)
        $trigger.Repetition = $repeat.Repetition
        Register-ScheduledTask -TaskName 'win_workman remove defaultuser0' -Force -Trigger $trigger `
            -Principal (New-ScheduledTaskPrincipal -UserId 'S-1-5-18' -LogonType ServiceAccount -RunLevel Highest) `
            -Action (New-ScheduledTaskAction -Execute powershell.exe `
                -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$dir\remove-defaultuser0.ps1`"") | Out-Null
    } catch {
        Write-Output "WARNING: task to remove defaultuser0 not registered: $($_.Exception.Message)"
    }

    New-Item -Path "$log.done" -ItemType File -Force | Out-Null
    $ok = $true
} catch {
    Write-Output "FAILED: $($_.Exception.Message)"
    New-Item -Path "$log.failed" -ItemType File -Force | Out-Null
    $ok = $false
} finally {
    Stop-Transcript
}
if ($ok) {
    # Drop the copy of the MSI and of the key; kept after a failure, to run again.
    Remove-Item -Path $here -Recurse -Force -ErrorAction SilentlyContinue
}
# Setup goes on whatever happens: a failure shows as no SSH and the log above.
exit 0
